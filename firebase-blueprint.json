{
  "entities": {
    "opportunities": {
      "title": "opportunities",
      "description": "Salesforce opportunity qualification records logged by SDRs",
      "type": "object",
      "properties": {
        "opportunityName": { "type": "string" },
        "companyName": { "type": "string" },
        "companySource": { "type": "string" },
        "contactName": { "type": "string" },
        "contactTitle": { "type": "string" },
        "bant": {
          "type": "object",
          "properties": {
            "budget": { "type": "string" },
            "authority": { "type": "string" },
            "need": { "type": "string" },
            "timeline": { "type": "string" }
          }
        },
        "qualificationStatus": { "type": "string" },
        "sdrNextSteps": { "type": "string" },
        "aeNotes": { "type": "string" },
        "competitorMentions": {
          "type": "array",
          "items": { "type": "string" }
        },
        "validationVerdict": { "type": "string" },
        "transcript": { "type": "string" },
        "analyzedAt": { "type": "string" },
        "createdAt": { "type": "string" }
